<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sm_mrp_production_form_select_all_lines" model="ir.ui.view">
        <field name="name">mrp.production.form.select.all.lines</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_raw_ids']" position="before">
                <div class="d-flex gap-2 mb-2">
                    <button name="sm_select_all_raw_moves" string="Select All" type="object" class="btn btn-outline-primary"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='move_raw_ids']/list/field[@name='product_id']" position="before">
                <button name="sm_action_toggle_select" type="object" icon="fa-square-o" title="Select" invisible="sm_check_ok"/>
                <button name="sm_action_toggle_select" type="object" icon="fa-check-square" title="Unselect" invisible="not sm_check_ok" class="text-success"/>
                <field name="sm_check_ok" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='move_byproduct_ids']" position="before">
                <div class="d-flex gap-2 mb-2">
                    <button name="sm_select_all_byproduct_moves" string="Select All" type="object" class="btn btn-outline-primary"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='move_byproduct_ids']/list/field[@name='product_id']" position="before">
                <button name="sm_action_toggle_select" type="object" icon="fa-square-o" title="Select" invisible="sm_check_ok"/>
                <button name="sm_action_toggle_select" type="object" icon="fa-check-square" title="Unselect" invisible="not sm_check_ok" class="text-success"/>
                <field name="sm_check_ok" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
