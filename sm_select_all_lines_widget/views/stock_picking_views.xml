<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sm_stock_picking_form_select_all_lines" model="ir.ui.view">
        <field name="name">stock.picking.form.select.all.lines</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids_without_package']" position="before">
                <div class="d-flex gap-2 mb-2">
                    <button name="sm_select_all_moves" string="Select All" type="object" class="btn btn-outline-primary"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='product_id']" position="before">
                <button name="sm_action_toggle_select" type="object" icon="fa-square-o" title="Select" invisible="sm_check_ok"/>
                <button name="sm_action_toggle_select" type="object" icon="fa-check-square" title="Unselect" invisible="not sm_check_ok" class="text-success"/>
                <field name="sm_check_ok" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
