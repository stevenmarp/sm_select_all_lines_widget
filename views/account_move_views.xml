<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sm_account_move_form_select_all_lines" model="ir.ui.view">
        <field name="name">account.move.form.select.all.lines</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <div class="d-flex gap-2 mb-2">
                    <button name="sm_select_all_invoice_lines" string="Select All" type="object" class="btn btn-outline-primary"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='sequence']" position="before">
                <button name="sm_action_toggle_select" type="object" icon="fa-square-o" title="Select" invisible="sm_check_ok"/>
                <button name="sm_action_toggle_select" type="object" icon="fa-check-square" title="Unselect" invisible="not sm_check_ok" class="text-success"/>
                <field name="sm_check_ok" column_invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='line_ids']" position="before">
                <div class="d-flex gap-2 mb-2">
                    <button name="sm_select_all_journal_items" string="Select All" type="object" class="btn btn-outline-primary"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='line_ids']/list/field[@name='account_id']" position="before">
                <button name="sm_action_toggle_select" type="object" icon="fa-square-o" title="Select" invisible="sm_check_ok"/>
                <button name="sm_action_toggle_select" type="object" icon="fa-check-square" title="Unselect" invisible="not sm_check_ok" class="text-success"/>
                <field name="sm_check_ok" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
